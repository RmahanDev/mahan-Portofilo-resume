RewriteEngine On

# -----------------------------
# پوشه Projects
# هر چیزی داخل Projects بدون .html دیده شود
# -----------------------------
RewriteRule ^Projects/([^/]+)/?$ Projects/$1.html [L]

# -----------------------------
# پوشه Blogs
# هر چیزی داخل Blogs بدون .html دیده شود
# -----------------------------
RewriteRule ^Blogs/([^/]+)/?$ Blogs/$1.html [L]

# -----------------------------
# صفحات اصلی روت (اختیاری)
# -----------------------------
RewriteRule ^(blog|contact|portfolio|resume)/?$ $1.html [L]
