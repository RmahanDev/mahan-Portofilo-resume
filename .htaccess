Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # اگر فایل یا پوشه‌ای با همین اسم وجود دارد، دست نزن
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # -----------------------------
  # URLهای بدون پسوند را به .html نگاشت کن (سراسری)
  # -----------------------------
  # هر چیزی مثل /foo یا /dir/bar → /foo.html یا /dir/bar.html
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
