RewriteEngine On

# حذف .html از URL برای Projects
RewriteCond %{THE_REQUEST} \s/Projects/(project-[0-9]+)\.html[\s?] [NC]
RewriteRule ^Projects/(project-[0-9]+)\.html$ /Projects/%1 [R=301,L]

# حذف .html از URL برای Blogs
RewriteCond %{THE_REQUEST} \s/Blogs/(post-[0-9]+)\.html[\s?] [NC]
RewriteRule ^Blogs/(post-[0-9]+)\.html$ /Blogs/%1 [R=301,L]

# لود داخلی Projects
RewriteRule ^Projects/(project-[0-9]+)/?$ /$1.html [L]

# لود داخلی Blogs
RewriteRule ^Blogs/(post-[0-9]+)/?$ Blogs/$1.html [L]

# صفحات اصلی
RewriteRule ^(blog|contact|portfolio|resume)/?$ $1.html [L]
